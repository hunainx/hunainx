<svg xmlns="http://www.w3.org/2000/svg" width="$w" height="$h" viewBox="0 0 $w $h" role="img" aria-labelledby="title">
<title id="title">$title</title>
<style>
.chip{fill:$surface;stroke:$line_strong}.glyph{fill:none;stroke:$accent;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.label{fill:$text}
@media (prefers-reduced-motion: reduce){*{animation:none!important}}
</style>
<defs>$defs</defs>
$body
</svg>
